{
  "compilerOptions": {
    /* Configurações Principais */
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    
    /* Pastas */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Interoperabilidade e Tipos */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["jest", "node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}